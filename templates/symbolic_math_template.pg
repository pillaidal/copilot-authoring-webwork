## DESCRIPTION
## Symbolic MathObjects starter template
## ENDDESCRIPTION
DOCUMENT();
loadMacros("PGstandard.pl","MathObjects.pl","PGML.pl","PGcourse.pl");
Context("Numeric");
Context()->variables->add(x=>'Real');

$a = non_zero_random(-6,6,1);
$n = random(2,5,1);
$f = Formula("(x+$a)^$n");
$answer = $f->D('x');

BEGIN_PGML
### Symbolic starter
Differentiate

[`f(x)=[$f].`]

[`f'(x)=`] [__________]{$answer}
END_PGML

ANS($answer->cmp);
ENDDOCUMENT();
